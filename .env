# ============================================================
# AWS Configuration
# ============================================================
AWS_REGION=us-east-1
ACCOUNT_ID=415642395658

# ============================================================
# ECR (Elastic Container Registry)
# ============================================================
ECR_REPO=back-end-ecom
ECR_URL=${ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com
IMAGE=${ECR_URL}/${ECR_REPO}:${BUILD_NUMBER}

# ============================================================
# ECS (Elastic Container Service)
# ============================================================
ECS_CLUSTER=back-end-ecom
ECS_SERVICE=back-end-ecom-service-n0ylsjdr
TASK_FAMILY=back-end-ecom

# ============================================================
# Jenkins AWS Credentials ID (dung trong Jenkins Credentials Store)
# Khong luu AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY truc tiep o day
# Thay vao do cau hinh credentials ID trong Jenkins UI
# ============================================================
AWS_CREDENTIALS_ID=aws-ecs
